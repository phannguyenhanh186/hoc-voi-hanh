  {
   "id": "ngu-phap",
   "titleVi": "Ngữ pháp",
   "titleEn": "Grammar",
   "subtopics": [
    {
     "id": "khong-phai-la",
     "label": "Không phải là",
     "exercises": [
      {
       "type": "grammarNote",
       "noNum": true,
       "instructionVi": "",
       "title": "PHỦ ĐỊNH DANH TÍNH – NEGATING IDENTITY",
       "blocks": [
        {
         "type": "paragraph",
         "vi": "“Không phải là” được dùng để phủ định danh tính, nghề nghiệp, quốc tịch hoặc đặc điểm nhận dạng của một người hay một sự vật. Cấu trúc này thường được sử dụng khi muốn nói ai đó hoặc cái gì đó không phải là người hoặc vật được nhắc đến.",
         "en": "“Không phải là” is used to deny the identity, occupation, nationality, or classification of a person or thing. It is commonly used to say that someone or something is not the person or thing being referred to."
        },
        {
         "type": "heading",
         "vi": "Cấu trúc",
         "en": "Structure",
         "tone": "purple"
        },
        {
         "type": "structure",
         "vi": "S + {{không phải là::pink}} + [danh từ].",
         "en": "Subject + {{không phải là::pink}} + [noun]."
        },
        {
         "type": "heading",
         "vi": "Ví dụ",
         "en": "Examples",
         "tone": "purple"
        },
        {
         "type": "exampleGroup",
         "tone": "blue",
         "groups": [
          {
           "label": "Khẳng định – Positive sentence",
           "lines": [
            {
             "vi": "Mình là giáo viên.",
             "en": "I am a teacher."
            }
           ]
          },
          {
           "label": "Phủ định – Negative sentence",
           "lines": [
            {
             "vi": "Mình {{không phải là::pink}} giáo viên.",
             "en": "I am not a teacher."
            }
           ]
          },
          {
           "label": "Khẳng định – Positive sentence",
           "lines": [
            {
             "vi": "Chị ấy là người Hàn Quốc.",
             "en": "She is a Korean."
            }
           ]
          },
          {
           "label": "Phủ định – Negative sentence",
           "lines": [
            {
             "vi": "Chị ấy {{không phải là::pink}} người Hàn Quốc.",
             "en": "She is not a Korean."
            }
           ]
          },
          {
           "label": "Khẳng định – Positive sentence",
           "lines": [
            {
             "vi": "Đây là sách của Mai.",
             "en": "This is Mai's book."
            }
           ]
          },
          {
           "label": "Phủ định – Negative sentence",
           "lines": [
            {
             "vi": "Đây {{không phải là::pink}} sách của Mai.",
             "en": "This is not Mai's book."
            }
           ]
          }
         ]
        },
        {
         "type": "heading",
         "vi": "Phân biệt KHÔNG và KHÔNG PHẢI",
         "en": "Difference between KHÔNG and KHÔNG PHẢI",
         "tone": "purple"
        },
        {
         "type": "table",
         "columns": [
          "KHÔNG",
          "KHÔNG PHẢI"
         ],
         "rows": [
          [
           "Dùng để phủ định một hành động, trạng thái, tính chất hoặc đặc điểm.\nUsed to negate an action, state, quality, or characteristic.",
           "Dùng để phủ định hoặc đính chính danh tính, nghề nghiệp, sự vật hoặc thông tin được xác định bằng danh từ.\nUsed to deny or correct an identity, profession, object, or information expressed by a noun."
          ],
          [
           "Ví dụ: Mình không thích cá.\nI don't like fish.",
           "Ví dụ: Mình không phải là giáo viên.\nI'm not a teacher."
          ],
          [
           "Ví dụ: Chị Hương không thường dậy sớm.\nHương doesn't usually wake up early.",
           "Ví dụ: Chị ấy không phải là người Nhật.\nShe's not Japanese."
          ],
          [
           "Ví dụ: Hải không mệt.\nHải isn't tired.",
           "Ví dụ: Hôm nay không phải là Chủ Nhật.\nToday isn't Sunday."
          ]
         ]
        }
       ]
      }
     ]
    }
   ]
  }
