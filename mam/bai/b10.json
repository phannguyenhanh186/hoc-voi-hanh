   "id": "ngu-phap",
   "titleVi": "Ngữ pháp",
   "titleEn": "Grammar",
   "subtopics": [
    {
     "id": "khi-nao",
     "label": "Khi nào?",
     "exercises": [
      {
       "type": "grammarNote",
       "noNum": true,
       "instructionVi": "",
       "title": "KHI NÀO? · WHEN?",
       "blocks": [
        {
         "type": "heading",
         "vi": "1. Cách dùng",
         "en": "Usage",
         "tone": "purple"
        },
        {
         "type": "structure",
         "vi": "Khi nào?",
         "en": "When?"
        },
        {
         "type": "paragraph",
         "vi": "Dùng “khi nào” để hỏi về thời gian một hành động xảy ra.",
         "en": "Use “khi nào” to ask when an action happens."
        },
        {
         "type": "examples",
         "items": [
          {
           "vi": "Bạn đi làm {{khi nào::blue}}?",
           "en": "When do you go to work?"
          },
          {
           "vi": "{{Khi nào::pink}} bạn đi du lịch?",
           "en": "When are you going on vacation?"
          },
          {
           "vi": "{{Khi nào::pink}} bạn về Việt Nam?",
           "en": "When are you coming back to Vietnam?"
          }
         ]
        },
        {
         "type": "heading",
         "vi": "2. Vị trí của “khi nào”",
         "en": "Word order",
         "tone": "purple"
        },
        {
         "type": "paragraph",
         "vi": "Vị trí của “khi nào” có thể giúp chúng ta hiểu người nói đang hỏi về thời gian của sự việc như thế nào.",
         "en": "The position of “khi nào” can help us understand what kind of timing the speaker is asking about."
        },
        {
         "type": "heading",
         "vi": "A. KHI NÀO ở cuối câu",
         "en": "WHEN at the end of a question"
        },
        {
         "type": "structure",
         "vi": "Chủ ngữ + hành động + {{KHI NÀO}}?",
         "en": "Subject + action + WHEN?",
         "tone": "blue"
        },
        {
         "type": "paragraph",
         "vi": "Dùng để hỏi về thời gian một sự việc xảy ra, chẳng hạn như thói quen, lịch trình hoặc một sự việc đã xảy ra.",
         "en": "Use this structure to ask when something happens, such as a routine, schedule, or an event that has already happened."
        },
        {
         "type": "exampleGroup",
         "tone": "blue",
         "groups": [
          {
           "label": "THÓI QUEN — ROUTINES",
           "vi": "Bạn đi làm {{khi nào}}?",
           "en": "When do you go to work?",
           "note": "→ Hỏi về lịch trình thường ngày. / Asking about a regular schedule."
          },
          {
           "label": "SỰ VIỆC ĐÃ XẢY RA — PAST EVENTS",
           "vi": "Hôm qua bạn về nhà {{khi nào}}?",
           "en": "When did you get home yesterday?",
           "note": "→ Hỏi về thời gian một sự việc đã xảy ra. / Asking about the time of a past event."
          }
         ]
        },
        {
         "type": "heading",
         "vi": "B. KHI NÀO ở đầu câu",
         "en": "WHEN at the beginning of a question"
        },
        {
         "type": "structure",
         "vi": "{{KHI NÀO}} + chủ ngữ + hành động?",
         "en": "WHEN + subject + action?",
         "tone": "pink"
        },
        {
         "type": "paragraph",
         "vi": "Dùng để hỏi về thời điểm một sự việc sẽ xảy ra, đặc biệt khi muốn biết kế hoạch hoặc sự việc sắp tới.",
