        {
          "id": "chao-hoi",
          "label": "Chào hỏi (Greetings)",
          "exercises": [
            {
              "type": "grammarNote",
              "noNum": true,
              "instructionVi": "",
              "blocks": [
                {
                  "type": "heading",
                  "text": "Basic Vietnamese Greetings",
                  "tone": "purple"
                },
                {
                  "type": "structure",
                  "vi": "Chào + [{{2P Pronoun::blue}}] – Hello / Goodbye\nCám ơn + [{{2P Pronoun::blue}}] – Thank you\nXin lỗi + [{{2P Pronoun::blue}}] – Sorry",
                  "en": "Chào + [{{2P Pronoun::blue}}] – Hello / Goodbye\nCám ơn + [{{2P Pronoun::blue}}] – Thank you\nXin lỗi + [{{2P Pronoun::blue}}] – Sorry",
                  "white": true
                },
                {
                  "type": "paragraph",
                  "text": "[{{2P Pronoun::blue}}] refers to the person you are talking to.",
                  "italic": true
                },
                {
                  "type": "note",
                  "title": "Culture Note:",
                  "text": "These greetings are usually followed by the other person's pronoun to sound more natural and polite."
                },
                {
                  "type": "paragraph",
                  "text": "To ask \"How are you?\", use:"
                },
                {
                  "type": "structure",
                  "vi": "[{{2P Pronoun::blue}}] + khỏe không?",
                  "en": "[{{2P Pronoun::blue}}] + khỏe không?",
                  "white": true
                },
                {
                  "type": "paragraph",
                  "text": "The pronoun refers to the person you are talking to."
                },
                {
                  "type": "paragraph",
                  "text": "To say \"I'm fine / I'm good\", use:"
                },
                {
                  "type": "structure",
                  "vi": "[{{Your Pronoun::pink}}] + khỏe.",
                  "en": "[{{Your Pronoun::pink}}] + khỏe.",
                  "white": true
                },
                {
                  "type": "note",
                  "title": "Cultural Note:",
                  "bullets": [
                    "Khỏe means healthy or well.",
                    "Không is used at the end a question to form a yes/no question.",
                    "You can add cảm ơn (thank you) to make your answer more polite: Mình khỏe, cảm ơn!"
                  ]
                }
              ]
            }
          ]
        }
      ]
