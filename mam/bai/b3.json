{
 "_guide": {
  "doc": "Bai hoc kieu 'slide day hoc': sidebar trai = cac section, noi dung ben phai. Trang: bai.html?id=b2&level=mam. App bo qua key bat dau bang '_'.",
  "status": "Da co section 'phat-am' (Bai 1-4: van cuoi n/m), 'tu-vung' (Bai 5: photoVocab, Bai 6: photoFill), 'nghe' (Bai 7: dung/sai, Bai 8: chon cau dung) va 'ngu-phap' (khong danh so - ghi chu 'Thich - Like', giong cach lam o b1). Cac phan sau (noi, doc, viet...) se bo sung sau.",
  "exercise.grammarNote": "Ghi chu ngu phap song ngu, khong tuong tac (khong co dap an/audio). 'title' = tieu de lon. 'blocks' la mang cac khoi, moi khoi co 'type': 'paragraph' (doan van vi/en), 'heading' (tieu de nho vi/en), 'structure' (cong thuc vi/en, hien khung vang giong .grammar-callout co san), 'examples' (danh sach vi du dang an/hien - bam nut de mo, giong makeToggleSection cua grammar.html; moi item la {vi, en} - 'en' co the bo trong).",
  "exercise.sounds": "Cac van. 'columns' = danh sach cot; moi cot gom cac 'groups' (tone = yellow|pink|blue|violet); moi group gom cac 'rows'; o dau moi hang la nguyen am, cac o sau la am tiet. Hang ngan hon 3 o thi de trong (null).",
  "exercise.repeatSentences": "Nghe va lap lai ca cau (khong co cho trong). Moi item: 'text' (cau hien thi) + 'audio' (rieng, hoac dung chung ex.audio).",
  "exercise.listenPick": "Nghe va khoanh tron am dung. Moi item: 'options' (4 lua chon) + 'answer' (dap an - PHAI xac nhan lai truoc khi thu am, xem todo_answers).",
  "exercise.fillWords": "Giong fillNames nhung dien tu bat ky (khong chi ten). Moi item: before/after/answers[]/audio.",
  "exercise.photoFill": "Anh + cau co 1 cho trong, dien tu nghe duoc. Item dau tien co the danh dau 'example: true' de hien dap an to do lam mau (khong co o nhap). Moi item: img/name/template ('{0}' la cho trong)/answers (mang cac mang dap an chap nhan)/audio.",
  "exercise.audioChoice": "Item co the them 'text' (cau hien thi tren man hinh canh nut nghe) - dung cho dang dung/sai hoac can hien cau hoi ro rang. Neu khong co 'text' thi chi hien nut nghe + cac lua chon (dang nghe kin, khong hien chu).",
  "todo_images": "Duong dan img la placeholder: Bai 5 (tu vung) trong thu muc images/b3/bai5/, Bai 6 (photoFill) trong thu muc images/b3/bai6/ (6 anh: minh, thu, tram, thom, han, giang) - chua co file that, se bo sung sau.",
  "todo_audio_vocab": "9/10 tu (tu vung) da co san audio trong audio/b3/nam/. Rieng 'trai_cay' (trai cay) chua co file vocab_trai_cay.mp3, can thu am them.",
  "todo_audio_phatam": "Toan bo audio phan Phat am (pron_*, ex2_*, ex4_*) CHUA THU AM, xem file audio/b3/_pron_phatam_filenames.txt de biet danh sach can thu.",
  "todo_answers": "Bai 3 (listenPick) va Bai 4 (fillWords): dap an minh dien tam theo tu vung bai hoc, CAN BAN XAC NHAN LAI truoc khi thu am (vi dap an phai khop voi tu duoc doc trong file audio)."
