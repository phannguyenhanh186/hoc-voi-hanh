  "grammar": {
    "sections": [
      {
        "id": "g1",
        "titleVi": "Màu gì?",
        "titleEn": "Asking About Colors",
        "intro": [],
        "subtopics": [
          {
            "id": "g1",
            "label": "Màu gì?",
            "subHeadingVi": "Màu gì?",
            "subHeadingEn": "What Color?",
            "paragraphs": [
              "Use this pattern to ask what color something is or what color someone likes, wears, or wants. To answer, simply say: [Noun] + màu + [Color]."
            ],
            "chips": [
              {
                "pattern": "[Noun] + màu gì?\n→ [Noun] + màu + [Color]."
              }
            ],
            "examples": [
              {
                "vi": "Xe máy của bạn màu gì?\n→ Xe máy của mình màu trắng.",
                "en": "What color is your motorbike?\nMy motorbike is white."
              },
              {
                "vi": "Chị ấy không thích màu gì?\n→ Chị ấy không thích màu xanh dương.",
                "en": "What color doesn't she like?\nShe doesn't like blue."
              },
              {
                "vi": "Anh ấy thích điện thoại màu gì?\n→ Anh ấy thích điện thoại màu đen.",
                "en": "What color phone does he like?\nHe likes a black phone."
              },
              {
                "vi": "Em đang mặc áo màu gì?\n→ Em đang mặc áo màu xám.",
                "en": "What color shirt are you wearing?\nI'm wearing a gray shirt."
              }
            ],
            "quiz": [
              {
                "question": "How do you ask \"What color is your motorbike?\"",
                "options": [
                  "Xe máy của bạn là gì?",
                  "Xe máy của bạn màu gì?",
                  "Xe máy của bạn màu thế nào?"
                ],
                "answer": "Xe máy của bạn màu gì?"
              },
              {
                "question": "Which answer means \"My motorbike is white.\"",
                "options": [
                  "Xe máy của mình trắng.",
                  "Xe máy của mình trắng màu.",
                  "Xe máy của mình màu trắng."
                ],
                "answer": "Xe máy của mình màu trắng."
              },
              {
                "question": "Which question means \"What color shirt are you wearing?\"",
                "options": [
                  "Em mặc áo gì?",
                  "Em đang mặc áo màu gì?",
                  "Em đang mặc màu gì?"
                ],
                "answer": "Em đang mặc áo màu gì?"
              },
              {
                "question": "Which conversation is correct?",
                "options": [
                  "A: Kính của bạn màu gì?\nB: Kính của mình màu đỏ.",
                  "A: Điện thoại của bạn màu gì?\nB: Điện thoại của mình đỏ màu.",
                  "A: Bạn thích áo màu gì?\nB: Mình đang mặc quần màu đen."
                ],
                "answer": "A: Kính của bạn màu gì?\nB: Kính của mình màu đỏ."
              },
              {
                "question": "Which sentence means \"What color is this shirt?\"",
                "options": [
                  "Áo màu gì?",
                  "Áo này màu gì?",
                  "Áo này là màu gì?"
                ],
                "answer": "Áo này màu gì?"
              },
              {
                "question": "Which answer means \"It's black.\"",
                "options": [
                  "Màu vàng.",
                  "Màu xanh.",
                  "Màu đen."
                ],
                "answer": "Màu đen."
              },
              {
                "question": "Which question asks about someone's favorite car color?",
                "options": [
                  "Anh ấy có ô tô màu gì?",
                  "Anh ấy thích ô tô màu gì?",
                  "Anh ấy có ô tô màu đen không?"
                ],
                "answer": "Anh ấy thích ô tô màu gì?"
              },
              {
                "question": "Which conversation is correct?",
                "options": [
                  "A: Em đang mặc áo màu gì?\nB: Em đang có màu trắng.",
                  "A: Anh đang mặc áo màu gì?\nB: Anh đang mặc áo màu trắng.",
                  "A: Chị ấy đang mặc áo màu gì?\nB: Chị ấy thích màu trắng."
                ],
                "answer": "A: Anh đang mặc áo màu gì?\nB: Anh đang mặc áo màu trắng."
