  "grammar": {
    "points": [
      {
        "id": "g1",
        "title": "Màu gì? — Hỏi: ... + màu gì? → Trả lời: ... + màu + [màu]",
        "explanation": "",
        "examples": [
          "Xe máy của bạn màu gì? → Xe máy của mình màu trắng.",
          "Chị ấy không thích màu gì? → Chị ấy không thích màu xanh dương.",
          "Anh ấy thích điện thoại màu gì? → Anh ấy thích điện thoại màu đen.",
          "Em đang mặc áo màu gì? → Em đang mặc áo màu xám."
        ]
      },
      {
        "id": "g2",
        "title": "Lắm — câu khẳng định: Chủ ngữ + Động từ/Tính từ + lắm",
        "explanation": "'Lắm' dùng để nhấn mạnh mức độ rất cao của một tính chất, trạng thái hoặc hành động. Trong tiếng Anh, thường tương đương với 'a lot'.",
        "examples": [
          "Phở này ngon lắm.",
          "Em thích cà phê lắm.",
          "Hôm nay trời nóng lắm.",
          "Cảm ơn anh nhiều lắm."
        ]
      },
      {
        "id": "g3",
        "title": "Lắm — câu phủ định: Chủ ngữ + không + Động từ/Tính từ + lắm",
        "explanation": "",
        "examples": [
          "Gà này không ngon lắm.",
          "Anh không thích ở nhà lắm.",
          "Hôm nay trời không lạnh lắm.",
          "Mình không mệt lắm."
        ]
      },
      {
        "id": "g4",
        "title": "Thang mức độ 'thích'",
        "explanation": "",
        "examples": [
          "Không thích 🖤🖤",
          "Không thích lắm 🖤🤍",
          "Thích 🤍",
          "Thích lắm 🤍🤍"
        ]
      }
    ]
  },
