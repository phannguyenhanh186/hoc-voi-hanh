          {
            "id": "g1",
            "label": "Phải",
            "subHeadingVi": "Phải",
            "subHeadingEn": "Must",
            "paragraphs": [
              "Use phải to say that someone must, has to, or needs to do something. This pattern is commonly used to talk about rules, laws, or obligations."
            ],
            "chips": [
              {
                "pattern": "[Subject] + phải + [Verb]"
              }
            ],
            "examples": [
              {
                "vi": "Ở Việt Nam, bạn phải đội nón bảo hiểm khi ra đường.",
                "en": "In Vietnam, you must wear a helmet when you go out."
              },
              {
                "vi": "Em phải mặc áo khoác vì trời lạnh.",
                "en": "I have to wear a jacket because it's cold."
              },
              {
                "vi": "Mình phải đi làm lúc tám giờ.",
                "en": "I have to go to work at 8:00."
              },
              {
                "vi": "Chị phải mang hộ chiếu.",
                "en": "She has to bring her passport."
              }
            ],
            "quiz": [
              {
                "question": "What does phải mean?",
                "options": [
                  "can",
                  "must",
                  "want to"
                ],
                "answer": "must"
              },
              {
                "question": "Which sentence means \"You must wear a helmet.\"",
                "options": [
                  "Bạn đội nón bảo hiểm.",
                  "Bạn phải đội nón bảo hiểm.",
                  "Bạn thường đội nón bảo hiểm."
                ],
                "answer": "Bạn phải đội nón bảo hiểm."
              },
              {
                "question": "Complete the sentence which means \"I must wear a jacket.\": Em ______ mặc áo khoác.",
                "options": [
                  "phải",
                  "đang",
                  "không"
                ],
                "answer": "phải"
              },
              {
                "question": "Which sentence means \"I have to go to work.\"",
                "options": [
                  "Mình đi làm.",
                  "Mình phải đi làm.",
                  "Mình đang đi làm."
                ],
                "answer": "Mình phải đi làm."
              }
            ]
          }
