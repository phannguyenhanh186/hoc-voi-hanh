  "reading": {
    "passages": [
      {
        "id": "r1",
        "title": "Văn hóa đi lại ở Việt Nam",
        "audio": "audio/b9/{voice}/reading_r1.mp3",
        "text": "Ở Việt Nam, mọi người thường ra đường bằng xe máy. Xe máy rất tiện tại vì đường nhỏ và đông người. Khi đi xe máy, mọi người phải đội nón bảo hiểm. Tại vì ở đây trời rất nắng và nóng, họ phải đeo khẩu trang và đeo kính. Trời mưa, họ phải mặc áo mưa.\nBây giờ, nhiều người đi làm hoặc đi chơi bằng metro hoặc xe buýt. Ít người đi bộ, tại vì ở Việt Nam trời thường nắng và nóng, và đường cũng rất đông xe.\nTrong tuần, mọi người đến công ty làm việc vào buổi sáng và về nhà ăn cơm với gia đình vào buổi tối. Cuối tuần, mọi người thường đi ăn với gia đình hoặc đi ăn với bạn ở quán ăn. Họ cũng rất thích uống cà phê và trà.",
        "questions": [
          {
            "id": "rq1",
            "context": "Ở Việt Nam, mọi người thường đi bộ ra đường.",
            "options": [
              "Đúng",
              "Sai"
            ],
            "answer": "Sai"
          },
          {
            "id": "rq2",
            "context": "Khi đi xe máy, mọi người không phải đội nón bảo hiểm.",
            "options": [
              "Đúng",
              "Sai"
            ],
            "answer": "Sai"
          },
          {
            "id": "rq3",
            "context": "Bây giờ không nhiều người đi làm bằng tàu metro ở Việt Nam.",
            "options": [
              "Đúng",
              "Sai"
            ],
            "answer": "Sai"
          },
          {
            "id": "rq4",
            "context": "Ở Việt Nam, nhiều người đi bộ tại vì trời mát.",
            "options": [
              "Đúng",
              "Sai"
            ],
            "answer": "Sai"
          },
          {
            "id": "rq5",
            "context": "Người Việt Nam thích uống cà phê.",
            "options": [
              "Đúng",
              "Sai"
            ],
            "answer": "Đúng"
          }
        ]
      }
    ]
  },
