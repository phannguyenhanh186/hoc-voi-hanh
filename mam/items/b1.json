  "grammar": {
    "points": [
      {
        "id": "g1",
        "title": "Danh xưng — cách gọi người khác & gọi mình",
        "explanation": "Người Việt chọn danh xưng (anh/chị/em/bạn/mình) tùy theo tuổi tác so với người đang nói chuyện. Xem bảng đầy đủ ở phần chi tiết.",
        "examples": [],
        "refInput": "pronouns"
      },
      {
        "id": "g2",
        "title": "Chào + [Danh xưng]",
        "explanation": "Thêm danh xưng phù hợp ngay sau 'Chào' để chào ai đó.",
        "examples": [
          "Chào anh.",
          "Chào em."
        ]
      },
      {
        "id": "g3",
        "title": "Cám ơn + [Danh xưng]",
        "explanation": "Thêm danh xưng phù hợp ngay sau 'Cám ơn' để cảm ơn ai đó.",
        "examples": [
          "Cám ơn bạn.",
          "Cám ơn chị."
        ]
      },
      {
        "id": "g4",
        "title": "Xin lỗi + [Danh xưng]",
        "explanation": "Thêm danh xưng phù hợp ngay sau 'Xin lỗi' khi xin lỗi ai đó.",
        "examples": [
          "Xin lỗi em.",
          "Xin lỗi bạn."
        ]
      },
      {
        "id": "g5",
        "title": "[Danh xưng] + khoẻ không?",
        "explanation": "Hỏi thăm sức khoẻ; trả lời bằng cách lặp lại danh xưng rồi thêm 'khoẻ'.",
        "examples": [
          "Bạn khoẻ không? → Mình khoẻ.",
          "Anh khoẻ không? → Anh khoẻ."
        ]
      }
    ]
  },
