  "grammar": {
    "sections": [
      {
        "id": "pronouns",
        "titleVi": "Đại từ nhân xưng",
        "titleEn": "Personal Pronouns",
        "intro": [
          "Vietnamese personal pronouns are different from English. Instead of using only I, you, he, she, Vietnamese often uses words that show the relationship, age, or social position between speakers.",
          "The same person can use different pronouns in different situations."
        ],
        "subtopics": [
          {
            "id": "pronouns",
            "label": "Đại từ nhân xưng",
            "pronounContent": {
              "table": {
                "headers": [
                  "Situation",
                  "I / Me",
                  "You",
                  "Example"
                ],
                "rows": [
                  [
                    "Same age / friends",
                    "mình",
                    "bạn",
                    "**Mình** là Hạnh. → **Bạn** là ai?"
                  ],
                  [
                    "Older male → younger person",
                    "anh",
                    "em",
                    "**Anh** là Nam. → **Em** tên gì?"
                  ],
                  [
                    "Older female → younger person",
                    "chị",
                    "em",
                    "**Chị** là Lan. → **Em** tên gì?"
                  ],
                  [
                    "Younger person → older male",
                    "em",
                    "anh",
                    "**Em** là Minh. → **Anh** tên gì?"
                  ],
                  [
                    "Younger person → older female",
                    "em",
                    "chị",
                    "**Em** là Mai. → **Chị** tên gì?"
                  ],
                  [
                    "Younger person → older adult",
                    "con",
                    "cô / chú / bác / ông / bà",
                    "**Con** là Nam. → **Cô** tên gì?"
                  ]
                ]
              },
              "tip": "If you're not sure how old someone is, bạn is usually the safest choice.",
              "exampleGroups": [
                {
                  "heading": "Talking to someone older (male)",
                  "lines": [
                    {
                      "vi": "Chào anh.",
                      "en": "Hello."
                    },
                    {
                      "vi": "Anh khoẻ không?",
                      "en": "How are you?"
                    },
                    {
                      "vi": "→ Anh khoẻ.",
                      "en": "I'm good."
                    }
                  ]
                },
                {
                  "heading": "Talking to someone older (female)",
                  "lines": [
                    {
                      "vi": "Cám ơn chị.",
                      "en": "Thank you"
                    },
                    {
                      "vi": "Xin lỗi chị.",
                      "en": "Sorry."
                    }
                  ]
                },
                {
                  "heading": "Talking to someone younger",
                  "lines": [
                    {
                      "vi": "Chào em.",
                      "en": "Hello."
                    },
                    {
                      "vi": "Em khoẻ không?",
                      "en": "How are you?"
                    },
                    {
                      "vi": "→ Em khoẻ.",
                      "en": "I'm good."
                    }
                  ]
                },
                {
                  "heading": "Talking to someone your age",
                  "lines": [
                    {
                      "vi": "Chào bạn. Bạn khoẻ không?",
                      "en": "Hi. How are you?"
                    },
                    {
                      "vi": "→ Mình khoẻ. Cám ơn bạn.",
                      "en": "I'm fine. Thank you."
                    }
                  ]
                }
              ],
              "specialRule": {
                "heading": "A Special Rule",
                "text": "In Vietnamese, people often repeat the same pronoun instead of saying \"I.\" For example:",
                "examples": [
                  {
                    "lines": [
                      {
                        "vi": "Anh khỏe không?",
                        "en": "How are you?"
                      },
                      {
                        "vi": "Anh khỏe.",
                        "en": "I'm fine."
                      }
                    ],
                    "note": "Here, anh means \"you\" in the question, but \"I\" in the answer. This sounds completely natural in Vietnamese."
                  },
                  {
                    "lines": [
                      {
                        "vi": "Chị thích cà phê không?",
                        "en": "Do you like coffee?"
                      },
                      {
                        "vi": "Chị thích.",
                        "en": "Yes, I do."
                      }
                    ]
                  }
                ]
              },
              "remember": {
                "heading": "Remember",
                "text": "You don't need to memorize every Vietnamese pronoun at the beginning. For now, just remember these three pairs:",
                "pairs": [
                  "anh/chị ↔ em",
                  "em ↔ anh/chị",
                  "bạn ↔ mình"
                ],
                "footer": "These are enough for most everyday conversations with Vietnamese speakers."
              },
              "cultureNote": "Vietnamese pronouns show respect and closeness, not just who is speaking. Using the right pronouns makes your Vietnamese sound much more natural, even if your grammar is still simple. Many Vietnamese people appreciate the effort, and they will often help you choose the correct pronouns if you're unsure."
            },
            "quiz": [
              {
                "question": "You are talking to a friend who is about the same age as you. Which pair is most natural?",
                "options": [
                  "anh - em",
                  "chị - em",
                  "bạn - mình",
                  "cô - con"
                ],
                "answer": "bạn - mình"
              },
              {
                "question": "An older man is talking to a younger person. Which pair does he normally use?",
                "options": [
                  "anh - em",
                  "bạn - mình",
                  "con - chú",
                  "con - cô"
                ],
                "answer": "con - chú"
              },
              {
                "question": "You are introducing yourself as Lan to a person the same age as you: ____ là Lan.",
                "options": [
                  "Mình",
                  "Chị",
                  "Cô",
                  "Em"
                ],
                "answer": "Mình"
              },
              {
                "question": "A younger person is talking to an older woman: ____ là Mai. ____ tên gì?",
                "options": [
                  "Chị / Em",
                  "Cô / Con",
                  "Mình / Bạn",
                  "Con / Cô"
                ],
                "answer": "Con / Cô"
              },
              {
                "question": "Choose the most natural response for \"Chào anh!\"",
                "options": [
                  "Chào anh!",
                  "Chào em!",
                  "Chào bạn!",
                  "Chào chị!"
                ],
                "answer": "Chào em!"
              },
              {
                "question": "Choose the most natural response for \"Chị khoẻ không?\"",
                "options": [
                  "Em khoẻ.",
                  "Anh khoẻ.",
                  "Chị khoẻ.",
                  "Bạn khoẻ."
                ],
                "answer": "Chị khoẻ."
              }
            ]
          }
        ]
      },
      {
        "id": "greetings",
        "titleVi": "Chào hỏi",
        "titleEn": "Greetings",
        "subtopics": [
          {
            "id": "chao",
            "label": "Chào",
            "subHeadingVi": "Saying Hello and Goodbye",
            "subHeadingEn": "Chào",
            "paragraphs": [
              "Use chào to greet someone when you meet them. Vietnamese also commonly uses chào when saying goodbye.",
              "Unlike English, where hello and goodbye are different words, Vietnamese can use chào for both situations.",
              "The pronoun you use depends on the relationship between the speaker and the listener."
            ],
            "chips": [
              {
                "pattern": "Chào + [Pronoun]"
              }
            ],
            "examples": [
              {
                "vi": "Chào bạn.",
                "en": "Hi. / Hello."
              },
              {
                "vi": "Chào anh.",
                "en": "Hello. / Hi."
              },
              {
                "vi": "Chào chị.",
                "en": "Hello. / Hi."
              },
              {
                "vi": "Chào em.",
                "en": "Hello. / Hi."
              }
            ]
          },
          {
            "id": "camon",
            "label": "Cảm ơn",
            "subHeadingVi": "Saying Thank You",
            "subHeadingEn": "Cám ơn",
            "paragraphs": [
              "Use cám ơn to thank someone.",
              "The pronoun after cám ơn tells you who you are thanking."
            ],
            "chips": [
              {
                "pattern": "Cám ơn + [Pronoun]"
              }
            ],
            "examples": [
              {
                "vi": "Cám ơn cô."
              },
              {
                "vi": "Cám ơn em."
              },
              {
                "vi": "Cám ơn bác."
              }
            ]
          },
          {
            "id": "xinloi",
            "label": "Xin lỗi",
            "subHeadingVi": "Saying Sorry",
            "subHeadingEn": "Xin lỗi",
            "paragraphs": [
              "Use xin lỗi to apologize or to politely get someone's attention.",
              "Xin lỗi can mean both “I'm sorry” and “Excuse me.”",
              "“Không sao” is a common response to apologies, which means “It's OK”."
            ],
            "chips": [
              {
                "label": "Q",
                "pattern": "Xin lỗi + [Pronoun]"
              },
              {
                "label": "A",
                "pattern": "Không sao"
              }
            ],
            "examples": [
              {
                "vi": "Xin lỗi bạn. → Không sao."
              },
              {
                "vi": "Xin lỗi ông. → Không sao."
              },
              {
                "vi": "Xin lỗi bà. → Không sao."
              }
            ]
          },
          {
            "id": "khoe",
            "label": "Khoẻ không?",
            "subHeadingVi": "How are you?/Fine",
            "subHeadingEn": "Khoẻ không?/Khoẻ",
            "paragraphs": [
              "Use “khỏe không?” to ask someone how they are.",
              "Literally, khỏe means healthy / well, but in this expression, [Pronoun] + khỏe không? is a common way to ask “How are you?”.",
              "A simple answer is: “[Pronoun] + khoẻ.”"
            ],
            "chips": [
              {
                "label": "Q",
                "pattern": "[Pronoun] + khoẻ không?"
              },
              {
                "label": "A",
                "pattern": "[Pronoun] + khoẻ."
              }
            ],
            "examples": [
              {
                "vi": "Bạn khoẻ không? → Mình khoẻ."
              },
              {
                "vi": "Em khoẻ không? → Em khoẻ."
              },
              {
                "vi": "Cô khoẻ không? → Cô khoẻ."
              }
            ]
          }
        ],
        "quiz": [
          {
            "question": "What is the best expression to use when you meet your friend in the morning?",
            "options": [
              "Chào bạn.",
              "Cảm ơn chị.",
              "Xin lỗi anh.",
              "Bạn khỏe không?"
            ],
            "answer": "Chào bạn."
          },
          {
            "question": "What is the best expression to use when you want to ask your friend how they are?",
            "options": [
              "Chào chị.",
              "Cảm ơn em.",
