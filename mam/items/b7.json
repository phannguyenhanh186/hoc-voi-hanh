      {
        "id": "g4",
        "title": "Hỏi giá tiền — Của + [danh xưng]",
        "explanation": "Dùng khi hỏi tổng tiền của một người.",
        "examples": [
          "Của mình bao nhiêu tiền? - How much is mine?"
        ]
      },
      {
        "id": "g5",
        "title": "Hỏi giá tiền — Cái này / Cái kia",
        "explanation": "Dùng khi không biết hoặc không muốn nói tên món.",
        "examples": [
          "Cái này bao nhiêu tiền? - How much is this?",
          "Cái kia bao nhiêu tiền? - How much is that?"
        ]
      },
      {
        "id": "g6",
        "title": "Hỏi giá tiền — [Danh từ] + này",
        "explanation": "",
        "examples": [
          "Cơm này bao nhiêu tiền? - How much is this rice dish?",
          "Cà phê này bao nhiêu tiền? - How much is this coffee?",
          "Bánh ngọt này bao nhiêu tiền? - How much is this cake?"
        ]
      },
