        "id": "d1",
        "title": "Hội thoại 1: Cà phê",
        "lines": [
          { "audio": "audio/b2/{voice}/listen_d1_01.mp3", "text": "Em thích cà phê gì?", "wordBank": ["anh", "gì?", "là", "thích", "không", "uống", "em", "cà phê"] },
          { "audio": "audio/b2/{voice}/listen_d1_02.mp3", "text": "Em thích cà phê sữa. Chị có thích cà phê sữa không?", "wordBank": ["cà phê", "không?", "thích", "sữa", "gì?", "là", "sữa", "em", "thích", "đen", "cà phê"] },
