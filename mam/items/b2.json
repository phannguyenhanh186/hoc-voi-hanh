        "id": "d2",
        "title": "Hội thoại 2: Ăn gì?",
        "lines": [
          { "audio": "audio/b2/{voice}/listen_d2_01.mp3", "text": "Bạn thích ăn gì?", "wordBank": ["gì?", "thích", "uống", "bạn", "anh", "ăn"] },
          { "audio": "audio/b2/{voice}/listen_d2_02.mp3", "text": "Mình thích cơm gà và bún bò. Còn bạn?", "wordBank": ["cơm", "ăn", "bò", "thích", "mình", "uống", "bạn?", "Còn", "gà", "bún"] },
          { "audio": "audio/b2/{voice}/listen_d2_03.mp3", "text": "Mình cũng thích bún bò.", "wordBank": ["thích", "bò", "bạn", "cơm", "bún", "mình", "cũng"] },
          { "audio": "audio/b2/{voice}/listen_d2_04.mp3", "text": "Anh Minh thích ăn gì bạn biết không?", "wordBank": ["Minh", "thích", "bún", "anh", "bạn", "ăn", "không?", "biết", "gì"] },
          { "audio": "audio/b2/{voice}/listen_d2_05.mp3", "text": "Mình không biết.", "wordBank": ["biết", "bạn", "mình", "không", "thích"] }
        ]
      }
