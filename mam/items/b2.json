  "grammar": {
    "points": [
      {
        "id": "g1",
        "title": "[Chủ ngữ] + thích + [Danh từ] / [Động từ]",
        "explanation": "Dùng 'thích' để nói mình yêu thích một thứ gì đó hoặc thích làm một việc gì đó.",
        "examples": [
          "Minh thích cà phê sữa.",
          "Anh thích ăn bánh mì Việt Nam.",
          "Chị Linh thích đi chơi ở Sài Gòn."
        ]
      },
      {
        "id": "g2",
        "title": "[Chủ ngữ] + không thích + [Danh từ] / [Động từ]",
        "explanation": "Thêm 'không' trước 'thích' để nói mình không yêu thích một thứ gì đó hoặc không thích làm một việc gì đó.",
        "examples": [
          "Em không thích rau.",
          "Chị ấy không thích dọn nhà.",
          "Mẹ của mình không thích coi tivi."
        ]
      },
      {
        "id": "g3",
        "title": "[Chủ ngữ] + thích + [Danh từ] / [Động từ] + gì?",
        "explanation": "Dùng để hỏi người khác thích cái gì hoặc thích làm gì.",
        "examples": [
          "Bạn thích cà phê gì?",
          "Anh Nam thích ăn gì?",
          "Ba của bạn thích làm gì?"
        ]
      },
      {
        "id": "g4",
        "title": "[Chủ ngữ] + không thích + [Danh từ] / [Động từ] + gì?",
        "explanation": "Dùng để hỏi người khác không thích cái gì hoặc không thích làm gì.",
        "examples": [
          "Bạn không thích rau gì?",
          "Chị không thích uống nước gì?",
          "Em gái của bạn không thích làm gì?"
        ]
      }
    ]
  },
