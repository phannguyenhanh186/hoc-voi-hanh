        "lines": [
          { "audio": "audio/b3/{voice}/listen_d2_01.mp3", "text": "Bạn có thường ăn phở vào buổi sáng không?", "wordBank": ["phở", "thứ hai", "buổi sáng", "ăn", "có", "không?", "em", "bạn", "vào"] },
          { "audio": "audio/b3/{voice}/listen_d2_02.mp3", "text": "Mình có. Mình thích ăn phở vào buổi sáng.", "wordBank": ["có", "thường", "không", "ăn", "buổi tối", "bún", "thường", "vào", "mình", "buổi sáng", "bò", "mình"] },
          { "audio": "audio/b3/{voice}/listen_d2_03.mp3", "text": "Bạn thường ăn phở gì?", "wordBank": ["gì?", "ăn", "thích", "bạn", "phở", "không", "thường", "mình"] },
          { "audio": "audio/b3/{voice}/listen_d2_04.mp3", "text": "Mình thường ăn phở bò. Còn bạn?", "wordBank": ["ăn", "gà", "gì?", "bạn", "thích", "mình", "phở", "buổi tối", "thường"] },
          { "audio": "audio/b3/{voice}/listen_d2_05.mp3", "text": "Không. Mình thường ăn bún bò vào buổi sáng.", "wordBank": ["buổi sáng", "bún", "mình", "không", "thích", "vào", "bò", "thường", "bạn", "ăn", "phở"] }
