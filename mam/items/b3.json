  "grammar": {
    "points": [
      {
        "id": "g1",
        "title": "Vào + [Thứ] / [Buổi]",
        "explanation": "Dùng 'vào' trước thứ trong tuần hoặc buổi trong ngày để chỉ thời gian.",
        "examples": ["Vào thứ Hai.", "Vào buổi sáng.", "Vào buổi tối Chủ Nhật."]
      },
      {
        "id": "g2",
        "title": "[Chủ ngữ] + thường + [Động từ]",
        "explanation": "Dùng 'thường' để nói việc gì đó xảy ra thường xuyên, theo thói quen.",
        "examples": ["Mình thường đi làm vào buổi sáng.", "Anh Kiên thường ở nhà vào Chủ Nhật."]
      },
      {
        "id": "g3",
        "title": "[Chủ ngữ] + không thường + [Động từ]",
        "explanation": "Thêm 'không' trước 'thường' để nói việc gì đó không xảy ra thường xuyên.",
        "examples": ["Em không thường tập thể dục vào buổi trưa.", "Chị ấy không thường nấu ăn vào thứ Bảy và Chủ Nhật."]
      },
      {
        "id": "g4",
        "title": "[Chủ ngữ] + có thường + [Động từ] + không?",
        "explanation": "Dùng để hỏi ai đó có làm việc gì thường xuyên hay không.",
        "examples": ["Bạn có thường ăn phở không?", "Anh có thường uống cà phê vào buổi tối không?", "Chị có thường đi chơi vào buổi tối thứ Sáu không?"]
      }
    ]
  },

  "listening": {
    "instruction": "Nghe và gõ lại câu bạn nghe được. Bấm vào từ trong ngân hàng từ bên dưới nếu cần trợ giúp.",
