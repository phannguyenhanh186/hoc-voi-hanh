        "lines": [
          { "audio": "audio/b3/{voice}/listen_d1_01.mp3", "text": "Em thường làm gì vào tối thứ Bảy?", "wordBank": ["thường", "gì", "thứ bảy?", "làm", "em", "tối", "vào", "thứ hai", "là"] },
