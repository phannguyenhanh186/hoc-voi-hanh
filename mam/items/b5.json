  "grammar": {
    "sections": [
      {
        "id": "g0",
        "titleVi": "Số 21-99",
        "titleEn": "Reading Numbers from 21 to 99",
        "intro": [],
        "subtopics": [
          {
            "id": "g0",
            "label": "Số 21-99",
            "subHeadingVi": "Số 21-99",
            "subHeadingEn": "Numbers 21-99",
            "paragraphs": [
              "Numbers from 21 to 99 are read by saying the tens first, followed by the ones."
            ],
            "chips": [
              {
                "pattern": "[Tens] + [Ones]"
              }
            ],
            "examples": [
              {
                "vi": "Hai mươi",
                "en": "20"
              },
              {
                "vi": "Bốn ba",
                "en": "43"
              },
              {
                "vi": "Bảy bảy",
                "en": "77"
              }
            ],
            "tipBlocks": [
              {
                "tip": "Language Tip 1: When 1 is the last digit of a number from 21 to 99, it is usually pronounced mốt instead of một.",
                "examples": [
                  {
                    "vi": "Hai mốt",
                    "en": "21"
                  },
                  {
                    "vi": "Sáu mốt",
                    "en": "61"
                  }
                ]
              },
              {
                "tip": "Language Tip 2: When 4 is the last digit of a number from 20 to 99, it can be pronounced bốn or tư. Both are correct.",
                "examples": [
                  {
                    "vi": "Bốn bốn / Bốn tư",
                    "en": "44"
                  },
                  {
                    "vi": "Tám bốn / Tám tư",
                    "en": "84"
                  }
                ]
              },
              {
                "tip": "Language Tip 3: When 5 is the last digit of a number from 10 to 99, it is usually pronounced lăm instead of năm.",
                "examples": [
                  {
                    "vi": "Mười lăm",
                    "en": "15"
                  },
                  {
                    "vi": "Ba lăm",
                    "en": "35"
                  }
                ]
              }
            ],
            "quiz": [
              {
                "question": "Which is the natural way to read 21?",
                "options": [
                  "Hai một",
                  "Hai mốt",
                  "Một hai",
                  "Mốt hai"
                ],
                "answer": "Hai mốt"
              },
              {
                "question": "Which is the natural way to read 61?",
                "options": [
                  "Sáu một",
                  "Sáu mốt",
                  "Một sáu",
                  "Mốt sáu"
                ],
                "answer": "Sáu mốt"
              },
              {
                "question": "Which reading is correct for 44?",
                "options": [
                  "Bốn một",
                  "Bốn hai",
                  "Bốn ba",
                  "Bốn tư"
                ],
                "answer": "Bốn tư"
              },
              {
                "question": "Which is the natural way to read 35?",
                "options": [
                  "Ba năm",
                  "Ba lăm",
                  "Năm ba",
                  "Lăm ba"
                ],
                "answer": "Ba lăm"
              },
              {
                "question": "Which is the natural way to read 84?",
                "options": [
                  "Tám mốt",
                  "Tám bốn",
                  "Tám lăm",
                  "Tám tám"
                ],
                "answer": "Tám bốn"
              },
              {
                "question": "Which sentence is NOT the natural pronunciation?",
                "options": [
                  "Hai mốt",
                  "Sáu lăm",
                  "Ba năm",
                  "Tám tư"
                ],
                "answer": "Ba năm"
              }
            ]
          }
        ]
      },
      {
        "id": "g1",
        "titleVi": "Ngày & Tháng",
        "titleEn": "Days & Months",
        "intro": [],
        "subtopics": [
          {
            "id": "g1",
            "label": "Ngày & Tháng",
            "subHeadingVi": "Ngày & Tháng",
            "subHeadingEn": "Days & Months",
            "paragraphs": [
              "Use ngày followed by a number to say the day of the month. Use tháng followed by a number to say the month of the year. For April, you can say either tháng tư or tháng bốn. Both are correct."
            ],
            "chips": [
              {
                "pattern": "Ngày + [Day]\nTháng + [Month]"
              }
            ],
            "examples": [
              {
                "vi": "Ngày mười.",
                "en": "The 10th."
              },
              {
                "vi": "Tháng hai.",
                "en": "February."
              },
              {
                "vi": "Ngày ba mươi tháng tư.",
                "en": "April 30th."
              },
              {
                "vi": "Ngày hai mốt tháng mười một.",
                "en": "November 21st."
              }
            ],
            "quiz": [
              {
                "question": "Which phrase means \"February\"?",
                "options": [
                  "Ngày hai",
                  "Ngày ba",
                  "Tháng hai",
                  "Ngày ba"
                ],
                "answer": "Tháng hai"
              },
              {
                "question": "Which phrase means \"the 10th\"?",
                "options": [
                  "Tháng mười",
                  "Tháng mươi",
                  "Ngày mười",
                  "Mười ngày"
                ],
                "answer": "Ngày mười"
              },
              {
                "question": "Which sentence means \"April 30th\"?",
                "options": [
                  "Tháng ba mươi ngày tư",
                  "Ngày ba mươi tháng tư",
                  "Ba mươi tháng tư ngày",
                  "Ngày tư tháng ba mươi"
                ],
                "answer": "Ngày ba mươi tháng tư"
              },
              {
                "question": "Which two words can both be used for April?",
                "options": [
                  "Tháng mười / Tháng mươi",
                  "Tháng tư / Tháng bốn",
                  "Tháng năm / Tháng lăm",
                  "Tháng một / Tháng mốt"
                ],
                "answer": "Tháng tư / Tháng bốn"
              },
              {
                "question": "Which sentence means \"July 20th\"?",
                "options": [
                  "Ngày hai mươi tháng bảy",
                  "Tháng hai mươi ngày bảy",
                  "Tháng bảy ngày hai",
                  "Ngày bảy tháng hai mươi"
                ],
                "answer": "Ngày hai mươi tháng bảy"
              }
            ]
          }
        ]
      },
      {
        "id": "g2",
        "titleVi": "Thứ mấy?",
        "titleEn": "Which Day of the Week?",
        "intro": [],
        "subtopics": [
          {
            "id": "g2",
            "label": "Thứ mấy?",
            "subHeadingVi": "Thứ mấy?",
            "subHeadingEn": "Which Day of the Week?",
            "paragraphs": [
              "Use this pattern to ask what day of the week it is. You can ask about today, yesterday, or tomorrow. To answer, use: ... là + day of the week."
            ],
            "chips": [
              {
                "pattern": "Hôm nay / Hôm qua / Ngày mai là thứ mấy?\n→ ... là thứ ..."
              }
            ],
            "examples": [
              {
                "vi": "Hôm nay là thứ mấy?\n→ Hôm nay là thứ Ba.",
                "en": "What day is it today?\nToday is Tuesday."
              },
              {
                "vi": "Hôm qua là thứ mấy?\n→ Hôm qua là Chủ Nhật.",
                "en": "What day was it yesterday?\nYesterday was Sunday."
              },
              {
                "vi": "Ngày mai là thứ mấy?\n→ Ngày mai là thứ Sáu.",
                "en": "What day is it tomorrow?\nTomorrow is Friday."
              }
            ],
            "quiz": [
              {
                "question": "How do you ask \"What day is it today?\"",
                "options": [
                  "Hôm nay là năm mấy?",
                  "Hôm nay là thứ mấy?",
                  "Hôm nay là mấy giờ?",
                  "Hôm nay là tháng mấy?"
                ],
                "answer": "Hôm nay là thứ mấy?"
              },
              {
                "question": "Which answer means \"Today is Tuesday.\"",
                "options": [
                  "Hôm nay là thứ Ba.",
                  "Hôm nay là ngày ba.",
                  "Hôm nay là tháng ba.",
                  "Hôm nay là ba giờ."
                ],
                "answer": "Hôm nay là thứ Ba."
              },
              {
                "question": "Complete the sentence: Hôm qua là ______.",
                "options": [
                  "mười ngày",
                  "Chủ Nhật",
                  "tháng hai",
                  "bảy giờ"
                ],
                "answer": "Chủ Nhật"
              },
              {
                "question": "Which question asks about tomorrow's date?",
                "options": [
                  "Hôm qua là thứ mấy?",
                  "Hôm nay là thứ mấy?",
                  "Ngày mai là ngày mấy?",
                  "Ngày mai là tháng mấy?"
                ],
                "answer": "Ngày mai là ngày mấy?"
              },
              {
                "question": "Which conversation is correct?",
                "options": [
                  "A: Ngày mai là thứ mấy?\nB: Ngày mai là thứ Sáu.",
                  "A: Ngày mai là ngày mấy?\nB: Thứ Sáu là ngày mai.",
                  "A: Hôm nay là mấy giờ?\nB: Hôm nay là thứ Sáu.",
                  "A: Hôm qua là tháng mấy?\nB: Hôm qua là Chủ Nhật."
                ],
                "answer": "A: Ngày mai là thứ mấy?\nB: Ngày mai là thứ Sáu."
              }
            ]
          }
        ]
      },
      {
        "id": "g3",
        "titleVi": "Ngày mấy?",
        "titleEn": "Which Day?",
        "intro": [],
        "subtopics": [
          {
            "id": "g3",
            "label": "Ngày mấy?",
            "subHeadingVi": "Ngày mấy?",
            "subHeadingEn": "Which Day?",
            "paragraphs": [
              "Use this pattern to ask for a specific date. You can ask about the day of the month, the month, or the full date (day, month, and year). To answer, simply say: ... là ngày... You can include the month and year if needed."
            ],
            "chips": [
              {
                "pattern": "Hôm nay / Sinh nhật của bạn là ngày mấy / tháng mấy?\n→ ... là ngày [Day] (tháng [Month] năm [Year])."
              }
            ],
            "examples": [
              {
                "vi": "Hôm nay là ngày mấy?\n→ Hôm nay là ngày ba mốt.",
                "en": "What is today's date?\nToday is the 31st."
              },
              {
                "vi": "Sinh nhật của bạn là tháng mấy?\n→ Sinh nhật của mình là tháng tám.",
                "en": "Which month is your birthday in?\nMy birthday is in August."
              },
              {
                "vi": "Hôm nay là ngày mấy?\n→ Hôm nay là ngày hai mươi tháng ba.",
                "en": "What is today's date?\nToday is March 20th."
              },
              {
                "vi": "Sinh nhật của chị Liên là ngày mấy?\n→ Ngày mười một tháng tư.",
                "en": "What is Liên's birthday?\nApril 11th."
              }
            ],
            "quiz": [
              {
                "question": "How do you ask \"What is today's date?\"",
                "options": [
                  "Hôm nay là năm mấy?",
                  "Hôm nay là ngày mấy?",
                  "Hôm nay là tháng mấy?",
                  "Hôm nay mấy giờ?"
                ],
                "answer": "Hôm nay là ngày mấy?"
              },
              {
                "question": "Which answer means \"Today is March 20th.\"",
                "options": [
                  "Hôm nay là ngày hai mươi tháng ba.",
                  "Hôm nay là thứ Ba ngày hai mươi.",
                  "Hôm nay là tháng ba ngày hai.",
                  "Hôm nay là thứ hai ngày ba mươi."
                ],
                "answer": "Hôm nay là ngày hai mươi tháng ba."
              },
              {
                "question": "How do you ask \"Which month is your birthday in?\"",
                "options": [
                  "Sinh nhật của bạn là ngày mấy?",
                  "Sinh nhật của bạn là tháng mấy?",
                  "Bạn sinh nhật mấy giờ?",
                  "Tháng của bạn là tháng mấy?"
                ],
                "answer": "Sinh nhật của bạn là tháng mấy?"
              },
              {
                "question": "Which answer means \"My birthday is in August.\"",
                "options": [
                  "Sinh nhật của mình là tháng tám.",
                  "Sinh nhật của mình là ngày tám.",
                  "Tháng tám là của sinh nhật mình.",
