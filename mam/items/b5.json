  "reading": {
    "passages": [
      {
        "id": "r1",
        "title": "Sinh nhật ở Việt Nam",
        "text": "Ở Việt Nam, nhiều người thích sinh nhật. Sinh nhật là một ngày đặc biệt trong năm. Vào ngày này, mọi người thường ăn uống với gia đình hoặc bạn. Có người tổ chức sinh nhật ở nhà. Có người tổ chức ở nhà hàng hoặc quán cà phê.\nNhiều người Việt biết ngày, tháng và năm sinh của mình. Tuy nhiên, một số người lớn tuổi không biết chính xác sinh nhật.\nNgày nay, nhiều người trẻ thường tổ chức sinh nhật mỗi năm với gia đình và bạn. Sinh nhật là ngày để mọi người gặp nhau, ăn uống và nói chuyện.",
        "questions": [
          {
            "id": "rq1",
            "context": "Vào ngày sinh nhật, mọi người thường ăn uống với _____.",
            "options": [
              "Bạn thân",
              "Gia đình hoặc bạn",
              "Đồng nghiệp hoặc bạn"
            ],
            "answer": "Gia đình hoặc bạn"
          },
          {
            "id": "rq2",
            "context": "Mọi người thường tổ chức sinh nhật ở nhà, _____.",
            "options": [
              "nhà hàng hoặc quán cà phê",
              "công ty hoặc nhà hàng",
              "nhà hàng hoặc chợ"
            ],
            "answer": "nhà hàng hoặc quán cà phê"
          },
          {
            "id": "rq3",
            "context": "Một số _____ thường không biết chính xác ngày sinh.",
            "options": [
              "Trẻ con",
              "Người trẻ",
              "Người lớn tuổi"
            ],
            "answer": "Người lớn tuổi"
          }
        ]
      }
    ]
  },
