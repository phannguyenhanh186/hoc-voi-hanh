  "grammar": {
    "sections": [
      {
        "id": "g1",
        "titleVi": "Đang",
        "titleEn": "Talking About Actions Happening Now",
        "intro": [],
        "subtopics": [
          {
            "id": "g1",
            "label": "Đang",
            "subHeadingVi": "Đang",
            "subHeadingEn": "Somthing is Happening Now",
            "paragraphs": [
              "Use đang to talk about an action that is happening now, at the moment of speaking. It is similar to the present continuous in English (be + verb-ing)."
            ],
            "chips": [
              {
                "pattern": "[Subject] + đang + [Verb]"
              }
            ],
            "examples": [
              {
                "vi": "Mình đang ăn.",
                "en": "I'm eating."
              },
              {
                "vi": "Anh đang uống cà phê.",
                "en": "He is drinking coffee."
              },
              {
                "vi": "Chị đang học.",
                "en": "She is studying."
              },
              {
                "vi": "Trời đang mưa to.",
                "en": "It is raining heavily."
              }
            ],
            "quiz": [
              {
                "question": "What does \"đang\" tell us?",
                "options": [
                  "The action happened yesterday.",
                  "The action is happening now.",
                  "The action will happen tomorrow."
                ],
                "answer": "The action is happening now."
              },
              {
                "question": "Which sentence means \"She is studying.\"",
                "options": [
                  "Chị học.",
                  "Chị đang học.",
                  "Chị thường học."
                ],
                "answer": "Chị đang học."
              },
              {
                "question": "Which sentence means \"I am working\"",
                "options": [
                  "Chị làm việc.",
                  "Chị thường làm việc.",
                  "Chị đang làm việc."
                ],
                "answer": "Chị đang làm việc."
              },
              {
                "question": "Which sentence means \"It is raining.\"",
                "options": [
                  "Trời mưa.",
                  "Trời đang mưa.",
                  "Trời không mưa."
                ],
                "answer": "Trời đang mưa."
              }
            ]
          }
        ]
      },
