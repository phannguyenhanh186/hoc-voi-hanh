      "id": "g1",
      "label": "Đang",
      "subHeadingVi": "Đang",
      "subHeadingEn": "Something is Happening Now",
      "paragraphs": [
       "Use đang to talk about an action that is happening now, at the moment of speaking. It is similar to the present continuous in English (be + verb-ing)."
      ],
      "chips": [
       {
        "pattern": "[Subject] + đang + [Verb]"
       }
      ],
      "examples": [
       {
        "vi": "Mình đang ăn.",
        "en": "I'm eating."
       },
       {
        "vi": "Anh đang uống cà phê.",
        "en": "He is drinking coffee."
       },
       {
        "vi": "Chị đang học.",
        "en": "She is studying."
       },
       {
        "vi": "Trời đang mưa to.",
        "en": "It is raining heavily."
       }
      ],
      "quiz": [
