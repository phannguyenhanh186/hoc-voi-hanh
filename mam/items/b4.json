    "sections": [
      {
        "id": "g1",
        "titleVi": "Giờ/Phút",
        "titleEn": "Hour/Minute",
        "intro": [],
        "subtopics": [
          {
            "id": "g1",
            "label": "Giờ/Phút",
            "subHeadingVi": "Giờ/Phút",
            "subHeadingEn": "Talking About Time",
            "paragraphs": [
              "Use this pattern to tell the time in Vietnamese."
            ],
            "chips": [
              {
                "pattern": "[Hour] giờ ([Minute] phút) + sáng / trưa / chiều / tối"
              }
            ],
            "notes": [
              "Start with the hour.",
              "Add the minutes if needed.",
              "Finish with the time of day: sáng, trưa, chiều, or tối."
            ],
            "examples": [
              {
                "vi": "Chín giờ sáng.",
                "en": "9:00 a.m."
              },
              {
                "vi": "Mười một giờ mười lăm phút trưa.",
                "en": "11:15 a.m."
              },
              {
                "vi": "Ba giờ ba mươi phút chiều.",
                "en": "3:30 p.m."
              },
              {
                "vi": "Bảy giờ năm phút tối.",
                "en": "7:05 p.m."
              }
            ],
            "tipBlocks": [
              {
                "tip": "If there are no minutes, simply say: [Hour] giờ + time of day",
                "examples": [
                  {
                    "vi": "Sáu giờ sáng.",
                    "en": "6:00 a.m."
                  },
                  {
                    "vi": "Tám giờ tối.",
                    "en": "8:00 p.m."
                  }
                ]
              },
              {
                "tip": "If there are minutes, add them after giờ.",
                "examples": [
                  {
                    "vi": "Hai giờ hai mươi phút chiều.",
                    "en": "2:20 p.m."
                  },
                  {
                    "vi": "Chín giờ bốn mươi lăm phút sáng.",
                    "en": "9:45 a.m."
                  }
                ]
              }
            ],
            "quiz": [
              {
                "question": "Which sentence means \"3:30 p.m.\"?",
                "options": [
                  "Ba giờ sáng.",
                  "Ba giờ ba mươi phút chiều.",
                  "Ba giờ tối.",
                  "Ba mươi giờ chiều."
                ],
                "answer": "Ba giờ ba mươi phút chiều."
              },
              {
                "question": "Choose the correct order.",
                "options": [
                  "Sáng chín giờ.",
                  "Chín sáng giờ.",
                  "Chín giờ sáng.",
                  "Giờ chín sáng."
                ],
                "answer": "Chín giờ sáng."
              },
              {
                "question": "Complete the sentence: Bảy giờ mười lăm ______",
                "options": [
                  "phút",
                  "tối",
                  "giờ",
                  "buổi"
                ],
                "answer": "tối"
              },
              {
                "question": "Which sentence means \"11:15 a.m.\"?",
                "options": [
                  "Mười một giờ mười lăm phút trưa.",
                  "Mười một phút mười lăm giờ.",
                  "Trưa mười một giờ.",
                  "Mười một giờ tối."
                ],
                "answer": "Mười một giờ mười lăm phút trưa."
              },
              {
                "question": "Which sentence is correct?",
                "options": [
                  "Hai giờ chiều hai mươi phút.",
                  "Hai chiều giờ hai mươi.",
                  "Hai giờ hai mươi phút chiều.",
                  "Hai phút hai mươi giờ chiều."
