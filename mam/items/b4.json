            "chips": [
              {
                "pattern": "Bây giờ là mấy giờ?\n→ Bây giờ là + [Hour] giờ ([Minute] phút)."
              }
            ],
            "examples": [
              {
                "vi": "Bây giờ là mấy giờ?\n→ Bây giờ là tám giờ mười lăm phút.",
                "en": "What time is it now?\nIt's 8:15."
              },
              {
                "vi": "Bây giờ là mấy giờ?\n→ Bây giờ là mười hai giờ trưa.",
                "en": "What time is it now?\nIt's 12:00 noon."
