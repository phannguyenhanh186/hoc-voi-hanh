  "grammar": {
    "points": [
      {
        "id": "g1",
        "title": "[X] giờ ([Y] phút) + sáng/trưa/chiều/tối",
        "explanation": "Dùng để nói giờ trong ngày, thêm buổi (sáng/trưa/chiều/tối) sau số giờ (và số phút nếu có).",
        "examples": [
          "Chín giờ sáng.",
          "Mười một giờ mười lăm phút trưa.",
          "Ba giờ ba mươi phút chiều.",
          "Bảy giờ năm phút tối."
        ]
      },
      {
        "id": "g2",
        "title": "Bây giờ là mấy giờ? → Bây giờ là + [X] giờ ([Y] phút)",
        "explanation": "Dùng để hỏi và trả lời giờ hiện tại.",
        "examples": [
          "Bây giờ là mấy giờ? → Bây giờ là tám giờ mười lăm phút.",
          "Bây giờ là mấy giờ? → Bây giờ là mười hai giờ trưa."
        ]
      },
      {
        "id": "g3",
        "title": "[Chủ ngữ] + [Động từ] + lúc mấy giờ? → [Chủ ngữ] + [Động từ] + lúc + [X] giờ ([Y] phút)",
        "explanation": "Dùng để hỏi và trả lời thời điểm làm một việc gì đó.",
        "examples": [
          "Bạn ăn sáng lúc mấy giờ? → Mình ăn sáng lúc bảy giờ.",
          "Chị ấy thường đi làm lúc mấy giờ? → Chị ấy thường đi làm lúc tám giờ sáng.",
          "Hôm qua bạn đi ngủ lúc mấy giờ? → Mười một giờ rưỡi."
        ]
      }
    ]
  },
