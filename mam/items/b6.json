  "grammar": {
    "sections": [
      {
        "id": "g1",
        "titleVi": "Cho...",
        "titleEn": "Making Polite Requests",
        "intro": [],
        "subtopics": [
          {
            "id": "g1",
            "label": "Cho... - Making Polite Requests",
            "subHeadingVi": "Cho...",
            "subHeadingEn": "Making Polite Requests",
            "paragraphs": [
              "Use cho to make a polite request. You can use this pattern to ask for something (noun) or ask someone to do something (verb). This is one of the most common expressions when ordering food, shopping, or asking for help."
            ],
            "chips": [
              {
                "pattern": "Cho + [Pronoun] + [Noun / Verb]"
              }
            ],
            "examples": [
              {
                "vi": "Cho em một trà đá.",
                "en": "I'd like an iced tea, please."
              },
              {
                "vi": "Cho em tính tiền.",
                "en": "The bill, please."
              },
              {
                "vi": "Cho em coi menu.",
                "en": "May I see the menu, please?"
              },
              {
                "vi": "Chị ơi, cho em thêm một cái muỗng.",
                "en": "Excuse me, could I have another spoon, please?"
              }
            ],
            "quiz": [
              {
                "question": "Which sentence means \"I'd like an iced tea, please.\"",
                "options": [
                  "Cho em một trà đá.",
                  "Một trà đá cho em.",
                  "Em cho một trà đá."
                ],
                "answer": "Cho em một trà đá."
              },
              {
                "question": "Which sentence would you say when you want to pay?",
                "options": [
                  "Cho em coi menu.",
                  "Cho em tính tiền.",
                  "Cho em một phở."
                ],
                "answer": "Cho em tính tiền."
              },
              {
                "question": "Which sentence asks to see the menu?",
                "options": [
                  "Cho em tính tiền.",
                  "Cho em coi menu.",
                  "Cho em thêm nước."
                ],
                "answer": "Cho em coi menu."
              },
              {
                "question": "Which sentence is correct?",
                "options": [
                  "Một trà đá cho em chị ơi.",
                  "Chị ơi cho em một trà đá.",
                  "Chị ơi một trà đá cho em."
                ],
                "answer": "Chị ơi cho em một trà đá."
              }
            ]
          }
        ]
      },
      {
        "id": "g2",
        "titleVi": "Thêm",
        "titleEn": "Asking for More",
        "intro": [],
        "subtopics": [
          {
            "id": "g2",
            "label": "Thêm - Asking for More",
            "subHeadingVi": "Thêm",
            "subHeadingEn": "Asking for More",
            "paragraphs": [
              "Use thêm to ask for more of something. You can use it to order one more item or a larger quantity. This pattern is commonly used in restaurants and cafés."
            ],
            "chips": [
              {
                "pattern": "Thêm + [Number] + [Noun]"
              }
            ],
            "examples": [
              {
                "vi": "Cho em thêm một phở.",
                "en": "I'd like one more bowl of phở, please."
              },
              {
                "vi": "Cho anh thêm hai cà phê sữa.",
                "en": "Two more milk coffees, please."
              },
              {
                "vi": "Cho em thêm một chai nước.",
                "en": "One more bottle of water, please."
              },
              {
                "vi": "Cho mình thêm ba cái ly.",
                "en": "Three more glasses, please."
              }
            ],
            "quiz": [
              {
                "question": "What does thêm mean?",
                "options": [
                  "less",
                  "more",
                  "no"
                ],
                "answer": "more"
              },
              {
                "question": "Which sentence means \"One more bowl of phở, please.\"",
                "options": [
                  "Cho em một phở.",
                  "Cho em thêm một phở.",
                  "Em cho thêm một phở."
                ],
                "answer": "Cho em thêm một phở."
              },
              {
                "question": "Complete the sentence: Cho anh ______ hai cà phê sữa.",
                "options": [
                  "thêm",
                  "một",
                  "cho"
                ],
                "answer": "thêm"
              },
              {
                "question": "Which sentence is correct?",
                "options": [
                  "Cho mình thêm ba cái ly.",
                  "Cho thêm mình ba cái ly.",
                  "Mình thêm cho ba cái ly."
                ],
                "answer": "Cho mình thêm ba cái ly."
              }
            ]
          }
        ]
      },
      {
