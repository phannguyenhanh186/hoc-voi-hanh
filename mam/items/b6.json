  "grammar": {
    "points": [
      {
        "id": "g1",
        "title": "Cho + [Danh xưng] + [Danh từ] / [Động từ]",
        "explanation": "Dùng để lịch sự xin/gọi món gì đó hoặc nhờ ai làm gì.",
        "examples": [
          "Cho em một trà đá.",
          "Cho em tính tiền.",
          "Cho em coi menu.",
          "Chị ơi cho em thêm một cái muỗng."
        ]
      },
      {
        "id": "g2",
        "title": "Thêm + [số] + [danh từ]",
        "explanation": "Dùng để gọi thêm món hoặc thêm số lượng.",
        "examples": [
          "Cho em thêm một phở.",
          "Cho anh thêm hai cà phê sữa."
        ]
      },
      {
        "id": "g3",
        "title": "Ít / Nhiều / Không + đường/đá/sữa/ớt/rau…",
        "explanation": "Dùng để nói mức độ (ít, nhiều, hoặc không có) của một nguyên liệu trong món ăn/thức uống.",
        "examples": [
          "Cho em một cà phê đen không đường.",
          "Cho chị thêm một bún bò không ớt, nhiều rau.",
          "Cho em một cơm gà ít cơm."
        ]
      }
    ]
  },
