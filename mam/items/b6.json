  "reading": {
    "passages": [
      {
        "id": "r1",
        "title": "Văn hóa ăn uống ở Việt Nam",
        "audio": "audio/b6/{voice}/reading_r1.mp3",
        "text": "Ở Việt Nam, nhiều người thích ăn ở quán hoặc nhà hàng. Khi đến quán, mọi người thường coi menu rồi gọi món.\nNgười Việt Nam thường dùng đũa để ăn. Ngoài ra, mọi người dùng muỗng, chén, tô hoặc dĩa, tùy theo món ăn. Ví dụ, phở và bún thường ăn với tô, còn cơm gà thường ăn với chén hoặc dĩa. Người miền Nam thường thích thêm đường vào món ăn, còn người miền Trung và miền Bắc thích ăn với nhiều nước mắm hoặc ớt.",
        "questions": [
          {
            "id": "rq1",
            "context": "Khi đến quán, nhiều người thường làm gì trước?",
            "options": [
              "Tính tiền",
              "Coi thực đơn",
              "Uống cà phê"
            ],
            "answer": "Coi thực đơn"
          },
          {
            "id": "rq2",
            "context": "Phở và bún thường được ăn với gì?",
            "options": [
              "Chén",
              "Dĩa",
              "Tô"
            ],
            "answer": "Tô"
          },
          {
            "id": "rq3",
            "context": "Người miền Nam thích thêm gì vào món ăn?",
            "options": [
              "Đường",
              "Ớt",
              "Nước mắm"
            ],
            "answer": "Đường"
          }
        ]
      }
    ]
  },
